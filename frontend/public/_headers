# Cloudflare static assets: hashed bundles forever; media for a day (then
# refreshed in the background); the page itself always checked (Burnell's).
/static/*
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.mp4
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.webm
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/index.html
  Cache-Control: no-cache
/*.m4a
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.bin
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/fonts/*
  Cache-Control: public, max-age=2592000
/*.mp3
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
